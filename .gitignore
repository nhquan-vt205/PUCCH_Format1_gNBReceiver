# ============================================================================
# Allow-list: only HDL sources, simulation scripts, docs, AI skills, the AI
# instruction files (CLAUDE.md, AGENTS.md) and README are committed.
# Everything else is ignored.
# ============================================================================

# 1. Project root: ignore everything ...
/*

# ... except these
!/.gitignore
!/CLAUDE.md
!/AGENTS.md
!/README*
!/rtl/
!/tb/
!/testcases/
!/sim/
!/doc/
!/.claude/
!/.agents/

# 2. rtl/, tb/, testcases/: HDL source code only
/rtl/*
!/rtl/*.v
!/rtl/*.vh
!/rtl/*.sv
!/rtl/*.svh
/tb/*
!/tb/*.v
!/tb/*.vh
!/tb/*.sv
!/tb/*.svh
/testcases/*
!/testcases/*.v
!/testcases/*.vh
!/testcases/*.sv
!/testcases/*.svh

# 3. sim/: hand-written scripts only; every Makefile / simulator output
#    (work, log, coverage, covhtmlreport, *.wlf, *.ucdb, run_test.v, ...) is ignored
/sim/*
!/sim/Makefile
!/sim/*.f
!/sim/pat.list
!/sim/*.csh
!/sim/*.tcl
!/sim/script/

# 4. doc/: generated reports
/doc/report/
# MATLAB raw grid (~250 MB): over the GitHub 100 MB file limit
/doc/database/rx_grid_SNR_*.csv

# 5. AI folders: skills only
/.claude/*
!/.claude/skills/
/.agents/*
!/.agents/skills/

# 6. Anywhere: tool / editor leftovers
node_modules/
__pycache__/
*.pyc
*~
*.swp
.DS_Store
